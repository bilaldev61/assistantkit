{
    "name": "assistant-kit/assistant",
    "description": "A rules-first chat assistant for data-backed sites: your own catalogue answers first, an optional language model handles only the leftovers, and every dead end asks for a name and an email.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "assistant",
        "chatbot",
        "rules-engine",
        "lead-capture",
        "llm",
        "retrieval",
        "php",
        "framework-agnostic"
    ],
    "homepage": "https://github.com/bilaldev61/assistantkit",
    "authors": [
        {
            "name": "Bilal Raza",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/bilaldev61/assistantkit/issues",
        "source": "https://github.com/bilaldev61/assistantkit"
    },
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "laravel/framework": "For the Blade widget, Eloquent storage and the HTTP endpoint described in INTEGRATION.md."
    },
    "autoload": {
        "psr-4": {
            "AssistantKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AssistantKit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "demo": "php bin/demo.php",
        "test": "phpunit"
    }
}
